# --- Proxy toggle -----------------------------------------------------------
proxy() {
    local proxy_url="http://127.0.0.1:7890"
    export http_proxy="$proxy_url"
    export https_proxy="$proxy_url"
    export all_proxy="$proxy_url"
    export HTTP_PROXY="$proxy_url"
    export HTTPS_PROXY="$proxy_url"
    export ALL_PROXY="$proxy_url"
    echo "HTTP Proxy On"
}

noproxy() {
    unset http_proxy https_proxy all_proxy
    unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
    echo "HTTP Proxy off"
}

# --- Tar + zip packer -------------------------------------------------------
tp() {
    if [ -z "$1" ]; then
        echo "Usage: tp <folder> [name]"
        return 1
    fi

    local folder="${1%/}"
    local name="${2:-$(basename "$folder")}"
    local tarfile="$name.tar.gz"
    local zipfile="$name.zip"

    tar -czvf "$tarfile" "$folder" || return 1
    zip "$zipfile" "$tarfile" || return 1
    rm -f "$tarfile"
    chmod 755 "$zipfile"
    echo "$zipfile"
}

# --- Git branch hopper ------------------------------------------------------
g-() {
    local n=${1:-1}
    [[ $n =~ ^[0-9]+$ ]] || { echo "Usage: g- [number]"; return 1; }
    git switch @{-"$n"}
}

# --- Git timeline (two-branch merge-base view) ------------------------------
git_timeline2() {
    local A="$1"
    local B="$2"
    local BASE

    BASE=$(git merge-base "$A" "$B") || return 1

    echo "A: $A"
    git show --oneline --decorate --no-patch "$A"
    echo
    echo "B: $B"
    git show --oneline --decorate --no-patch "$B"
    echo
    echo "共同祖先:"
    git show --oneline --decorate --no-patch "$BASE"
    echo
    echo "时间线:"
    git log --graph --oneline --decorate --date-order --boundary \
        "$A" "$B" --not "$BASE^"
}

# --- OpenCV pixel reader ----------------------------------------------------
pix() {
    if [ -z "${3:-}" ]; then
        echo "Usage: pix <image> <x> <y>"
        return 1
    fi
    python3 -c "import cv2; img=cv2.imread('$1', cv2.IMREAD_UNCHANGED); print(img[$3,$2])"
}

# --- Docker cleanup (interactive) -------------------------------------------
docker-clean() {
    local confirm status=0 containers used_images='' images id ref size
    local -a candidates=()
    printf 'Docker context: '
    docker context show || return
    docker system df || return

    if read -r -p 'Prune unused build cache older than 30 days (default builder)? [y/N] ' confirm &&
        [[ "$confirm" == [yY] ]]; then
        docker buildx prune --builder default --filter until=720h --force || status=1
    fi

    containers=$(docker container ls --all --quiet --no-trunc) || return
    if [[ -n "$containers" ]]; then
        used_images=$(printf '%s\n' "$containers" | xargs docker container inspect --format \
            '{{.Image}}{{range .Mounts}}{{if eq .Type "image"}}{{"\nIMAGE_MOUNT"}}{{end}}{{end}}') || return
    fi
    if [[ $'\n'"$used_images"$'\n' == *$'\nIMAGE_MOUNT\n'* ]]; then
        echo 'Skipping image cleanup: a container has an image-backed mount.' >&2
        status=1
    else
        images=$(docker image ls --no-trunc --format '{{.ID}} {{.Repository}}:{{.Tag}} {{.Size}}') || return
        printf '\n%-52s %-16s %s\n' 'Unused image (candidate)' 'IMAGE ID' 'SIZE'
        while read -r id ref size; do
            [[ "$id" =~ ^sha256:[0-9a-f]{64}$ ]] || continue
            [[ $'\n'"$used_images"$'\n' == *$'\n'"$id"$'\n'* ]] && continue
            printf '%-52s %-16s %s\n' "$ref" "${id:7:12}" "$size"
            [[ " ${candidates[*]} " == *" $id "* ]] || candidates+=("$id")
        done <<< "$images"
        if ((${#candidates[@]} == 0)); then
            echo 'No unused image candidates.'
        else
            echo 'Only the IDs listed above will be attempted. Unused rollback images can be removed.'
            echo 'Docker may refuse removal, for example if an image has multiple tags or is now in use.'
            if read -r -p "Remove these ${#candidates[@]} image(s)? [y/N] " confirm && [[ "$confirm" == [yY] ]]; then
                docker image rm --no-prune "${candidates[@]}" || status=1
            fi
        fi
    fi

    printf '\nDocker disk usage after cleanup:\n'
    docker system df || return
    return "$status"
}

# --- tmux session helpers ----------------------------------------------------
_tmux_session_name() {
    local session="${1:-$(basename "$PWD")}"
    session="${session//[^A-Za-z0-9_.-]/_}"

    if [ -z "$session" ]; then
        echo "Usage: ta|tn|tk [session-name]" >&2
        return 1
    fi

    printf '%s\n' "$session"
}

ta() {
    local session
    session="$(_tmux_session_name "${1:-}")" || return 1
    tmux attach -t "$session"
}

tn() {
    local session
    session="$(_tmux_session_name "${1:-}")" || return 1
    tmux new -s "$session"
}

tk() {
    local session
    session="$(_tmux_session_name "${1:-}")" || return 1
    tmux kill-session -t "$session"
}

# --- git add + commit + push -------------------------------------------------
gacp() {
    local msg="$*"
    if [ -z "$msg" ]; then
        echo "Usage: gacp <commit-message>"
        return 1
    fi

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Not inside a Git worktree."
        return 1
    fi

    local changes
    changes=$(git status --short --untracked-files=all -- .) || return 1
    if [ -z "$changes" ]; then
        echo "Nothing to commit."
        return 1
    fi

    echo "Changes found:"
    printf '%s\n' "$changes"
    echo

    local answer add_mode
    while true; do
        if ! read -r -p "Stage, commit, and push? [y]es (tracked only)/[a]ll (include untracked)/[q]abort: " answer; then
            echo
            echo "Aborted."
            return 1
        fi
        case "$answer" in
            y|Y|yes|Yes|YES)
                add_mode="tracked"
                break
                ;;
            a|A|all|All|ALL)
                add_mode="all"
                break
                ;;
            q|Q|quit|Quit|QUIT|abort|Abort|ABORT|n|N|no|No|NO|"")
                echo "Aborted."
                return 1
                ;;
            *)
                echo "Enter 'yes', 'all', or 'abort'."
                ;;
        esac
    done

    if [ "$add_mode" = "tracked" ]; then
        git add -u -- . || return 1
    else
        git add . || return 1
    fi
    git commit -m "$msg" && git push
}

# --- Codex CLI wrapper (profile-aware) ---------------------------------------
codex() {
    local active=""
    [ -f "$HOME/.codex/active-profile" ] && active=$(cat "$HOME/.codex/active-profile")
    # Source secrets and export the right key for Codex subprocess
    local secrets="$HOME/scaffold/bash/secrets"
    [ -f "$secrets" ] && source "$secrets"
    case "$active" in
        deepseek) export DEEPSEEK_API_KEY ;;
        glm)      export GLM_API_KEY ;;
    esac
    if [ -n "$active" ]; then
        command codex --profile "$active" "$@"
    else
        command codex "$@"
    fi
}
